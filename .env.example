# ==========================================================================
# Genesis OS / UCCL - environment variable names
#
# Copy this file to `.env` and fill in the values you want.
#
#   copy .env.example .env
#
# `.env` is gitignored and holds live keys - never commit it. This file
# exists so the set of names is documented and reviewable without exposing
# any secret. Every value below is intentionally EMPTY.
#
# Nothing here is read at import time; the runtime resolves these through
# ai/ai_engine.py and genesis_os/genesis_config.py. An empty value means
# "not configured", and the runtime fails closed on the affected path
# rather than substituting a default key.
# ==========================================================================

# --------------------------------------------------------------------------
# Which provider answers when no explicit choice is made.
# `auto` tries the local model first, then cloud. Accepted values depend on
# the build; an unrecognised value behaves as `auto`.
# --------------------------------------------------------------------------
GENESIS_AI_MODE=

# --------------------------------------------------------------------------
# Local Ollama provider
# --------------------------------------------------------------------------
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=

# --------------------------------------------------------------------------
# OpenRouter (cloud)
# --------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=

# --------------------------------------------------------------------------
# Groq (cloud)
# --------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_MODEL=

# --------------------------------------------------------------------------
# Workspace boundary
#
# MUST BE AN ABSOLUTE PATH THAT EXISTS. A relative or nonexistent value is
# refused at configuration time: it would otherwise be resolved against
# whichever directory the process happens to be sitting in, so the
# effective boundary would differ from the configured one.
# --------------------------------------------------------------------------
GENESIS_WORKSPACE_ROOT=
